# Aplicación
NODE_ENV=development
PUERTO=3001
# Orígenes de la web autorizados a abrir el WebSocket, separados por coma
CORS_ORIGENES=http://localhost:5173

# Puente con la API (back/api)
# Base del REST: aquí se verifican las sesiones de quien se conecta
API_URL=http://localhost:3000/api/v1
# Secreto compartido con la API (TIEMPO_REAL_CLAVE_INTERNA allá). Mínimo 32 caracteres aleatorios:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLAVE_INTERNA=
